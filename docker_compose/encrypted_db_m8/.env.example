# .env — compose interpolation only (published addresses). No secret here.
# Public HTTPS router (D-21 blocks and header stripping). 127.0.0.1 keeps it
# on this host; set a LAN address to expose it on an isolated LAN segment.
PUBLIC_BIND_IP=127.0.0.1
PUBLIC_HTTPS_PORT=4431
# The unfiltered in-network path, always on 127.0.0.1 (see traefik.yml).
API_PORT=18080
