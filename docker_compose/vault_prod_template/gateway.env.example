# gateway.env — ai_gateway, ai_gateway_scheduler and ai-migrate
# (vault_prod_template). Copy to gateway.env; replace every changethis.
#
# No secret value lives here: every secret is a Docker secret mounted under
# /run/secrets and named by a <FIELD>_FILE key. Keys this stack does not use
# stay listed, commented out, so the settings fall back to their default.
# The ratified first-deployment values (Q4, Q5, Q6, Q12, D-05, the declined
# restore residual) are pinned; the compose policy test fails on any drift.

# ── Identity ──────────────────────────────────────────────────────────────────
# The hostname clients use. Production refuses localhost origins.
DOMAIN=changethis
ENVIRONMENT=production
STRICT_PRODUCTION_MODE=true
PROJECT_NAME=ai-gateway-m8
STACK_NAME=ai-gateway-vault-prod

# ── API & docs ────────────────────────────────────────────────────────────────
API_PREFIX=/ai
SET_OPEN_API=false
SET_DOCS=false
SET_REDOC=false

# ── CORS / Frontend ───────────────────────────────────────────────────────────
BACKEND_HOST=changethis
FRONTEND_HOST=changethis
BACKEND_CORS_ORIGINS=changethis
# The public name, the in-network name and loopback (container healthcheck).
ALLOWED_HOSTS=changethis

# ── Service role & auth routing ───────────────────────────────────────────────
AUTH_SERVICE_ROLE=consumer
AUTH_PREFIX=/user

# ── Database (ai_db; the runtime role) ────────────────────────────────────────
# ai-migrate overrides DB_USER/DB_PASSWORD_FILE with the ai_owner role.
SELECTED_DB=Postgres
DB_HOST=m8_db
DB_PORT=5432
DB_DATABASE=ai_db
DB_USER=ai_runtime
DB_PASSWORD_FILE=/run/secrets/ai_runtime_db_password

# ── App secret ────────────────────────────────────────────────────────────────
SECRET_KEY_FILE=/run/secrets/gateway_secret_key

# ── Token verification (issuer: auth_user_service) ────────────────────────────
ACCESS_TOKEN_ALGORITHM=RS256
JWKS_URI=http://auth_user_service:8000/user/.well-known/jwks.json
# The issuer is reached over app_net, an internal Docker network on this one
# host (the supported topology); no inter-service call leaves it. A multi-host
# deployment needs TLS between services (the mTLS follow-on) instead.
ALLOW_INTERNAL_HTTP=true
JWKS_CACHE_TTL_SECONDS=300
ACCESS_SECRET_KEY_FILE=/run/secrets/gateway_access_secret_key
REFRESH_SECRET_KEY_FILE=/run/secrets/gateway_refresh_secret_key
REFRESH_TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# Per-consumer private auth at the issuer: this id is the gateway's row in the
# issuer's PRIVATE_API_CONSUMERS (secrets/issuer_private_api_consumers.json).
TOKEN_MODE=stateful
INTROSPECTION_URL=http://auth_user_service:8000/user/private/v1/jti-status
INTERNAL_CLIENT_ID=ai-gateway
PRIVATE_API_SECRET_FILE=/run/secrets/gateway_private_api_secret
ACCESS_REVOCATION_FAILURE_MODE=fail_closed

TOKEN_STRICT_VALIDATION=true
TOKEN_ISSUER=changethis
TOKEN_AUDIENCE=changethis

# D-05: no gateway route accepts an API-key principal. Keep it unset or false.
#API_KEY_INTROSPECTION_ENABLED=false

# ── Event signing (auth event stream) ─────────────────────────────────────────
EVENT_SIGNING_ENABLED=true
EVENT_SIGNING_KEY_FILE=/run/secrets/event_signing_key
REVOCATION_CACHE_TTL_SECONDS=0

# ── Observability ─────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_GROUPS=all
METRICS_SCRAPE_CREDENTIAL_FILE=/run/secrets/metrics_scrape_credential
HEALTH_DETAIL_CREDENTIAL_FILE=/run/secrets/health_detail_credential

# ══ Gateway settings (C-14) ═══════════════════════════════════════════════════

# ── Installation identity (generated once by init.sh; never rotated) ──────────
AI_DEPLOYMENT_ID_FILE=/run/secrets/ai_deployment_id

# ── Run-mode (D-42) ──────────────────────────────────────────────────────────
# Never set here: the scheduler's command sets AI_RUN_MODE=scheduler.
#AI_RUN_MODE=scheduler

# ── Credential storage and key encryption ────────────────────────────────────
AI_CREDENTIAL_STORAGE_BACKEND=database
# Data keys are wrapped by the Vault transit key below; no KEK file exists.
AI_CREDENTIAL_KEK_PROVIDER=vault_transit
#AI_CREDENTIAL_KEK_FILE=
#AI_CREDENTIAL_KEK_PREVIOUS_FILES=
# Mounted on the web service only; the scheduler never reads it (D-42).
AI_CREDENTIAL_FINGERPRINT_KEY_FILE=/run/secrets/ai_fingerprint_key
#AI_CREDENTIAL_FINGERPRINT_PREVIOUS_KEY_FILE=
AI_CREDENTIAL_PREPARE_GRACE_SECONDS=300
AI_CREDENTIAL_RESOLVE_TIMEOUT_SECONDS=5
AI_MAX_CREDENTIALS_PER_SCOPE=20

# ── External Vault (https only; AppRole from Docker secrets; no root token) ───
# The external Vault's address: replace the host, keep https (production
# refuses http, and the compose policy test pins the scheme).
AI_VAULT_ADDR=https://vault.internal:8200
AI_VAULT_AUTH_METHOD=approle
#AI_VAULT_TOKEN_FILE=
AI_VAULT_ROLE_ID_FILE=/run/secrets/vault_role_id
AI_VAULT_SECRET_ID_FILE=/run/secrets/vault_secret_id
AI_VAULT_CA_FILE=/run/secrets/vault_ca.pem
# Recommended backend: database + vault_transit (policies/ai-gateway-transit.hcl).
AI_VAULT_TRANSIT_MOUNT=transit
AI_VAULT_TRANSIT_KEY=ai-gateway-kek
# Alternative, once T24 serves it: AI_CREDENTIAL_STORAGE_BACKEND=vault, no KEK
# provider, and these (policies/ai-gateway-kv.hcl).
#AI_VAULT_KV_MOUNT=ai-kv
#AI_VAULT_KV_PATH_PREFIX=ai-gateway
#AI_VAULT_QUIESCENCE_SECONDS=3600

# ── Callers, users and policy ─────────────────────────────────────────────────
# Digests and public keys only (init.sh registers the security suite's client
# and its test issuer key).
AI_SERVICE_CLIENTS_FILE=/run/secrets/ai_service_clients.json
# Q6: user and tenant BYOK both enabled from the first deployment.
AI_USER_BYOK_ENABLED=true
# Q4: the ratified default data-class table; keep this line commented.
#AI_DATA_CLASS_POLICY=
# Q12: ocr stays off until the OCR enablement gate (D-31) is met.
AI_CAPABILITIES_ENABLED=embedding,structured_output,rerank

# ── Provider destinations and client ─────────────────────────────────────────
AI_PROVIDER_ALLOWED_INTERNAL_HOSTS=ollama:11434
AI_PROVIDER_ALLOWED_EXTERNAL_PORTS=443
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_PROVIDER_TOTAL_DEADLINE_SECONDS=120
AI_PROVIDER_MAX_BACKOFF_SECONDS=300
AI_PROVIDER_FILE_EXPIRY_SECONDS=3600

# ── Request and payload bounds ────────────────────────────────────────────────
AI_MAX_REQUEST_BYTES=52428800
AI_MAX_RESPONSE_BYTES=16777216
AI_MAX_OCR_PAGES=100
AI_MAX_EMBED_INPUTS=64
AI_MAX_INPUT_CHARS=32768
AI_MAX_RERANK_CANDIDATES=100
AI_MAX_SCHEMA_BYTES=16384
AI_MAX_SCHEMA_DEPTH=8
AI_OCR_UPLOAD_INLINE_THRESHOLD_BYTES=1048576

# ── Job contexts and clocks ───────────────────────────────────────────────────
# Q5: a job context lives at most 900 seconds.
AI_JOB_CONTEXT_MAX_TTL_SECONDS=900
AI_JOB_CONTEXT_CLOCK_SKEW_SECONDS=5
AI_DISPATCH_CONTEXT_TTL_SECONDS=30
AI_MAX_CLOCK_SKEW_SECONDS=5

# ── Admission, budgets and reservations ───────────────────────────────────────
AI_TENANT_DAILY_BUDGET_UNITS=100000
AI_USER_DAILY_BUDGET_UNITS=20000
AI_CLIENT_DAILY_BUDGET_UNITS=200000
AI_RATE_LIMIT_PER_MINUTE=120
AI_MAX_INFLIGHT_PER_CLIENT=16
AI_RESERVATION_TTL_SECONDS=60

# ── Provider-side artifacts ───────────────────────────────────────────────────
AI_REMOTE_ARTIFACT_MAX_DELETE_ATTEMPTS=10
AI_REMOTE_ARTIFACT_MAX_PENDING_HOURS=72
AI_REMOTE_ARTIFACT_VISIBILITY_GRACE_SECONDS=300
AI_REMOTE_ARTIFACT_NEGATIVE_LISTINGS=3
AI_REMOTE_ARTIFACT_PLATFORM_INCIDENT_LISTING=true
AI_REMOTE_ARTIFACT_PLATFORM_SWEEP_ENABLED=false
# Declined at T1: keep unset. Setting it needs a separate, dated human
# acceptance of the restore residual.
#AI_RESTRICTED_OCR_RESTORE_RESIDUAL_ACCEPTED=false

# ── OCR spool (D-45: the ai_spool volume on both gateway services) ────────────
AI_OCR_SPOOL_DIR=/spool
AI_OCR_SPOOL_MAX_BYTES=2147483648
AI_OCR_SPOOL_TTL_SECONDS=300
AI_MAX_CONCURRENT_SPOOLS=4
AI_UPLOAD_TOTAL_TIMEOUT_SECONDS=120

# ── Execution receipts and retention ──────────────────────────────────────────
# Mounted on the web service only (D-42). The kid `python -m
# ai_sdk_m8.jobcontext keygen` printed for the seed (or leave it commented).
AI_EXECUTION_RECEIPT_KEY_FILE=/run/secrets/ai_receipt_seed
#AI_EXECUTION_RECEIPT_KID=
AI_EXECUTION_RETENTION_DAYS=90
