# auth.env — the issuer (tepochtli/fa-auth-m8), stack configuration only.
# init.sh copies this file to auth.env and binds ACCESS_KEY_ID.
#
# No secret value lives here. docker-compose.yml points every secret field at
# a Docker secret through <FIELD>_FILE: DB_PASSWORD, REDIS_PASSWORD,
# REFRESH_SECRET_KEY, FIRST_SUPERUSER_PASSWORD, PRIVATE_API_SECRET,
# SESSION_SECRET, TOKENS_ENCRYPTION_KEY, EVENT_SIGNING_KEY (the same file the
# gateway reads), ACCESS_PRIVATE_KEY and ACCESS_PUBLIC_KEY.

DOMAIN=ai-gateway.lan
ENVIRONMENT=production
STRICT_PRODUCTION_MODE=true
PROJECT_NAME=ai-gateway-issuer
STACK_NAME=ai-gateway-vault-kv-m8

API_PREFIX=/user
SET_OPEN_API=false
SET_DOCS=false
SET_REDOC=false
BACKEND_HOST=https://ai-gateway.lan:4431
FRONTEND_HOST=https://ai-gateway.lan:4431
BACKEND_CORS_ORIGINS=https://ai-gateway.lan:4431
# The public name, the in-network name the gateway calls and loopback.
ALLOWED_HOSTS=ai-gateway.lan,auth_user_service,127.0.0.1
SESSION_COOKIE_SECURE=true
TRUSTED_PROXY_COUNT=1
AUTH_SERVICE_ROLE=issuer

SELECTED_DB=Postgres
DB_HOST=m8_db
DB_PORT=5432
DB_DATABASE=auth_db
DB_USER=auth_user

REDIS_HOST=redis_cache
REDIS_PORT=6379
REDIS_USER=auth

ACCESS_TOKEN_ALGORITHM=RS256
REFRESH_TOKEN_ALGORITHM=HS256
# The kid of secrets/issuer_public_key.pem (DER SHA-256 prefix); init.sh binds it.
ACCESS_KEY_ID=changethis
TOKEN_MODE=stateful
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440
TOKEN_STRICT_VALIDATION=true
# Identical to the gateway's TOKEN_ISSUER and TOKEN_AUDIENCE.
TOKEN_ISSUER=https://auth.ai-gateway.localhost
TOKEN_AUDIENCE=https://ai-gateway.localhost

FIRST_SUPERUSER=admin@example.com
# The gateway's row (client ai-gateway, scopes introspection and event-stream):
# a salted digest, never the secret. init.sh writes it, single-quoted.
PRIVATE_API_CONSUMERS=changethis

EVENT_SIGNING_ENABLED=true
EVENT_STREAM_ENABLED=true
EVENT_STREAM_BUFFER_SIZE=256
EVENT_STREAM_HEARTBEAT_SECONDS=15
EVENT_STREAM_MAX_QUEUE=64

AUTH_STRICT_MODE=true
RATE_LIMIT_FAILURE_MODE=fail_closed
ACCESS_REVOCATION_FAILURE_MODE=fail_closed

METRICS_ENABLED=false
