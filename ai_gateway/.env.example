# Copy to .env and replace every "changethis" with a real value.
# ai_gateway is a consumer service: it validates tokens issued by fa-auth-m8
# (JWT/JWKS plus the private revocation API) and holds no signing key.
# Secrets may instead be mounted as files: set <FIELD>_FILE=/run/secrets/<name>.

# ── Identity ──────────────────────────────────────────────────────────────────
DOMAIN=localhost
ENVIRONMENT=local
PROJECT_NAME=ai-gateway-m8
STACK_NAME=ai-gateway-m8

# ── API & docs ────────────────────────────────────────────────────────────────
API_PREFIX=/ai
SET_OPEN_API=true
SET_DOCS=true
SET_REDOC=true

# ── CORS / Frontend ───────────────────────────────────────────────────────────
BACKEND_HOST=http://127.0.0.1:9000
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173

# ── Service role & auth routing ───────────────────────────────────────────────
AUTH_SERVICE_ROLE=consumer
# Must match the API_PREFIX of the issuer (fa-auth-m8 default: /user)
AUTH_PREFIX=/user

# ── Database (the gateway's own ai_db; PostgreSQL only) ───────────────────────
# The web and scheduler run as the runtime role. The ai-migrate one-shot runs
# with the schema-owner role's credentials instead.
SELECTED_DB=Postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ai_db
DB_USER=changethis
DB_PASSWORD=changethis

# ── App secret ────────────────────────────────────────────────────────────────
SECRET_KEY=changethis

# ── Token verification (issuer: fa-auth-m8) ───────────────────────────────────
ACCESS_TOKEN_ALGORITHM=RS256
JWKS_URI=http://auth_user_service:8000/user/.well-known/jwks.json
JWKS_CACHE_TTL_SECONDS=300
ACCESS_SECRET_KEY=changethis
REFRESH_SECRET_KEY=changethis
REFRESH_TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=3600

# Full revocation through the issuer's private API (fresh check on the writer,
# admin and superuser tiers).
TOKEN_MODE=stateful
INTROSPECTION_URL=http://auth_user_service:8000/user/private/v1/jti-status
PRIVATE_API_SECRET=changethis
ACCESS_REVOCATION_FAILURE_MODE=fail_closed

# iss/aud binding. Must match the issuer's TOKEN_ISSUER and this gateway's
# audience exactly.
TOKEN_STRICT_VALIDATION=true
TOKEN_ISSUER=changethis
TOKEN_AUDIENCE=changethis

# No gateway route accepts an API-key principal: keep remote API-key
# introspection off (API_KEY_INTROSPECTION_ENABLED stays unset or false).

# ── Event signing (auth event stream) ─────────────────────────────────────────
EVENT_SIGNING_ENABLED=true
EVENT_SIGNING_KEY=changethis
REVOCATION_CACHE_TTL_SECONDS=0

# ── Observability ─────────────────────────────────────────────────────────────
#METRICS_ENABLED=false
#METRICS_GROUPS=all
# Optional static scoped scrape credential for {API_PREFIX}/metrics.
#METRICS_SCRAPE_CREDENTIAL=changethis

# ══ Gateway settings ══════════════════════════════════════════════════════════
# Every gateway key is listed. Replace each placeholder, or delete a line whose
# feature this deployment does not use, so the settings fall back to their
# declared default.

# ── Installation identity (a UUID generated once; never rotated) ──────────────
AI_DEPLOYMENT_ID=changethis

# ── Credential storage and key encryption ────────────────────────────────────
# database | vault
AI_CREDENTIAL_STORAGE_BACKEND=changethis
# local | vault_transit (database backend only)
AI_CREDENTIAL_KEK_PROVIDER=changethis
AI_CREDENTIAL_KEK_FILE=changethis
AI_CREDENTIAL_KEK_PREVIOUS_FILES=changethis
AI_CREDENTIAL_FINGERPRINT_KEY_FILE=changethis
AI_CREDENTIAL_FINGERPRINT_PREVIOUS_KEY_FILE=changethis
AI_CREDENTIAL_PREPARE_GRACE_SECONDS=changethis
AI_CREDENTIAL_RESOLVE_TIMEOUT_SECONDS=changethis
AI_MAX_CREDENTIALS_PER_SCOPE=changethis

# ── Vault ─────────────────────────────────────────────────────────────────────
AI_VAULT_ADDR=changethis
# token_file | approle
AI_VAULT_AUTH_METHOD=changethis
AI_VAULT_TOKEN_FILE=changethis
AI_VAULT_ROLE_ID_FILE=changethis
AI_VAULT_SECRET_ID_FILE=changethis
AI_VAULT_CA_FILE=changethis
AI_VAULT_TRANSIT_MOUNT=changethis
AI_VAULT_TRANSIT_KEY=changethis
AI_VAULT_KV_MOUNT=changethis
AI_VAULT_KV_PATH_PREFIX=changethis
AI_VAULT_QUIESCENCE_SECONDS=changethis

# ── Callers, users and policy ─────────────────────────────────────────────────
AI_SERVICE_CLIENTS=changethis
AI_USER_BYOK_ENABLED=changethis
AI_DATA_CLASS_POLICY=changethis
AI_CAPABILITIES_ENABLED=changethis

# ── Provider destinations and client ─────────────────────────────────────────
AI_PROVIDER_ALLOWED_INTERNAL_HOSTS=changethis
AI_PROVIDER_ALLOWED_EXTERNAL_PORTS=changethis
AI_PROVIDER_TIMEOUT_SECONDS=changethis
AI_PROVIDER_TOTAL_DEADLINE_SECONDS=changethis
AI_PROVIDER_MAX_BACKOFF_SECONDS=changethis
AI_PROVIDER_FILE_EXPIRY_SECONDS=changethis

# ── Request and payload bounds ────────────────────────────────────────────────
AI_MAX_REQUEST_BYTES=changethis
AI_MAX_RESPONSE_BYTES=changethis
AI_MAX_OCR_PAGES=changethis
AI_MAX_EMBED_INPUTS=changethis
AI_MAX_INPUT_CHARS=changethis
AI_MAX_RERANK_CANDIDATES=changethis
AI_MAX_SCHEMA_BYTES=changethis
AI_MAX_SCHEMA_DEPTH=changethis
AI_OCR_UPLOAD_INLINE_THRESHOLD_BYTES=changethis

# ── Job contexts and clocks ───────────────────────────────────────────────────
AI_JOB_CONTEXT_MAX_TTL_SECONDS=changethis
AI_JOB_CONTEXT_CLOCK_SKEW_SECONDS=changethis
AI_DISPATCH_CONTEXT_TTL_SECONDS=changethis
AI_MAX_CLOCK_SKEW_SECONDS=changethis

# ── Admission, budgets and reservations ───────────────────────────────────────
AI_TENANT_DAILY_BUDGET_UNITS=changethis
AI_USER_DAILY_BUDGET_UNITS=changethis
AI_CLIENT_DAILY_BUDGET_UNITS=changethis
AI_RATE_LIMIT_PER_MINUTE=changethis
AI_MAX_INFLIGHT_PER_CLIENT=changethis
AI_RESERVATION_TTL_SECONDS=changethis

# ── Provider-side artifacts ───────────────────────────────────────────────────
AI_REMOTE_ARTIFACT_MAX_DELETE_ATTEMPTS=changethis
AI_REMOTE_ARTIFACT_MAX_PENDING_HOURS=changethis
AI_REMOTE_ARTIFACT_VISIBILITY_GRACE_SECONDS=changethis
AI_REMOTE_ARTIFACT_NEGATIVE_LISTINGS=changethis
AI_REMOTE_ARTIFACT_PLATFORM_INCIDENT_LISTING=changethis
AI_REMOTE_ARTIFACT_PLATFORM_SWEEP_ENABLED=changethis
# Declined at ratification: leave unset. Setting it needs a separate, dated
# human acceptance of the restore residual.
#AI_RESTRICTED_OCR_RESTORE_RESIDUAL_ACCEPTED=false

# ── OCR spool ─────────────────────────────────────────────────────────────────
AI_OCR_SPOOL_DIR=changethis
AI_OCR_SPOOL_MAX_BYTES=changethis
AI_OCR_SPOOL_TTL_SECONDS=changethis
AI_MAX_CONCURRENT_SPOOLS=changethis
AI_UPLOAD_TOTAL_TIMEOUT_SECONDS=changethis

# ── Execution receipts and retention ──────────────────────────────────────────
AI_EXECUTION_RECEIPT_KEY_FILE=changethis
AI_EXECUTION_RECEIPT_KID=changethis
AI_EXECUTION_RETENTION_DAYS=changethis
